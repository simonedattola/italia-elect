# URL pubblico, usato per metadata, sitemap e Open Graph.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sondaggi. JSON atteso: { "polls": [ { "id", "institute", "publishedAt", "sampleSize", "shares": { "lista-id": 12.3 }, "houseEffect"?: {}, "quality"?: "published" } ] }
# Senza URL il simulatore usa la serie dimostrativa solo se la attivi a mano.
POLLS_JSON_URL=""
POLLS_API_KEY=""

# Attualità. JSON atteso: { "economy", "security", "europe", "costOfLiving" } su scala -2…+2.
# Senza URL i fattori restano a zero.
NEWS_API_URL=""
NEWS_API_KEY=""

# Sentiment. JSON atteso: { "score": 0 } fra -1 e 1.
# Senza URL non viene imputato alcun punteggio.
SOCIAL_API_URL=""
SOCIAL_API_KEY=""
